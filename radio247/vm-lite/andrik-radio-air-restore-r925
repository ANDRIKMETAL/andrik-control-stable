#!/usr/bin/env bash
set -Eeuo pipefail

BASE="/opt/andrik-radio"
BACKUPS="$BASE/backups"
SERVER="$BASE/radio247/server.mjs"
VISUAL_DIR="/var/cache/andrik-radio-r622/visuals"
STAMP="$(date +%Y%m%d-%H%M%S)"
SAVE="$BACKUPS/BEFORE-R990R-GOLD-RESTORE-$STAMP"

echo "======================================================"
echo " ANDRIK R990R · АВАРИЙНЫЙ GOLD"
echo " LATEST R990 FULLSCREEN + CLEAN TITLES"
echo "======================================================"

[ -s "$SERVER" ] || { echo "❌ LIVE server.mjs missing"; exit 20; }

GOLD="$(find "$BACKUPS" -maxdepth 1 -type d \
  -name 'GOLD-R990-FULLSCREEN-CLEAN-TITLES-*' \
  -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)"

[ -n "$GOLD" ] || { echo "❌ GOLD R990 not found"; exit 21; }
[ -s "$GOLD/server.mjs" ] || { echo "❌ GOLD server.mjs missing: $GOLD"; exit 22; }

echo "GOLD=$GOLD"
node --check "$GOLD/server.mjs"

mkdir -p "$SAVE"
cp -a "$SERVER" "$SAVE/server.mjs"
[ -f /etc/systemd/system/andrik-radio.service ] && \
  cp -a /etc/systemd/system/andrik-radio.service "$SAVE/andrik-radio.service" || true

for f in \
  stream-morning-master-r703.mp4 \
  stream-day-master-r620.mp4 \
  stream-evening-master-r620.mp4 \
  stream-night-master-r620.mp4
do
  [ -f "$VISUAL_DIR/$f" ] && cp -a "$VISUAL_DIR/$f" "$SAVE/$f" || true
done

echo "✅ Current state saved: $SAVE"

systemctl stop andrik-radio.service
sleep 3

pkill -9 -f 'ffmpeg.*stream-morning-master-r703.mp4' 2>/dev/null || true
sleep 1

install -m 0644 "$GOLD/server.mjs" "$SERVER"

if [ -s "$GOLD/andrik-radio.service" ]; then
  install -m 0644 "$GOLD/andrik-radio.service" /etc/systemd/system/andrik-radio.service
  systemctl daemon-reload
fi

for f in \
  stream-morning-master-r703.mp4 \
  stream-day-master-r620.mp4 \
  stream-evening-master-r620.mp4 \
  stream-night-master-r620.mp4
do
  [ -s "$GOLD/$f" ] && install -m 0644 "$GOLD/$f" "$VISUAL_DIR/$f" || true
done

node --check "$SERVER"

if ! systemctl start andrik-radio.service; then
  echo "❌ GOLD start failed — restoring previous server"
  install -m 0644 "$SAVE/server.mjs" "$SERVER"
  systemctl start andrik-radio.service || true
  exit 30
fi

sleep 15
STATE="$(systemctl is-active andrik-radio.service || true)"
echo "service=$STATE"
[ "$STATE" = active ] || exit 31

echo "======================================================"
echo "✅ LATEST R990 GOLD RESTORED"
echo "✅ GOLD=$GOLD"
echo "✅ Previous state=$SAVE"
echo "======================================================"
