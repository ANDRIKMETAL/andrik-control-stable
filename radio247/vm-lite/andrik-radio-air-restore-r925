#!/usr/bin/env bash
set -Eeuo pipefail
BASE='/opt/andrik-radio'
LIVE="$BASE/radio247/server.mjs"
GOLD_LINK="$BASE/GOLD/GOLD-CURRENT"
SERVICE='andrik-radio.service'
SAFE='/root/ANDRIK-SAFE'
STAMP="$(date +%Y%m%d-%H%M%S)"
SAVE="$SAFE/BEFORE-R1138-GOLD-CORE-$STAMP.server.mjs"

echo '=========================================================='
echo ' ANDRIK R1138 · GOLD CORE RESTORE'
echo ' GOLD-CURRENT server.mjs only · CONTROL/LOUDNESS PRESERVED'
echo '=========================================================='
[ -s "$LIVE" ] || { echo '❌ live server missing'; exit 20; }
[ -e "$GOLD_LINK" ] || { echo "❌ GOLD-CURRENT missing: $GOLD_LINK"; exit 21; }
ROOT="$(readlink -f "$GOLD_LINK" 2>/dev/null || true)"
[ -n "$ROOT" ] && [ -d "$ROOT" ] || { echo '❌ GOLD-CURRENT symlink invalid'; exit 22; }
GSERVER="$ROOT/radio247/server.mjs"
[ -s "$GSERVER" ] || { echo "❌ GOLD server missing: $GSERVER"; exit 23; }
node --check "$GSERVER"
grep -Fq 'R1125-TRANSPORT-ISOLATION' "$GSERVER" || { echo '❌ GOLD lacks R1125 transport isolation'; exit 24; }
grep -Fq 'R1132-NATIVE-1080P25-DIRECT-NO-UNUSED-PNG' "$GSERVER" || { echo '❌ GOLD is older than R1132 visual CPU baseline'; exit 25; }
mkdir -p "$SAFE"
cp -a "$LIVE" "$SAVE"
echo "✅ current server saved: $SAVE"
rollback(){ echo '↩️ rollback previous server'; install -o root -g root -m0644 "$SAVE" "$LIVE"; node --check "$LIVE"; systemctl restart "$SERVICE" || true; }
install -o root -g root -m0644 "$GSERVER" "$LIVE"
node --check "$LIVE"
if ! systemctl restart "$SERVICE"; then rollback; exit 30; fi
sleep 10
if [ "$(systemctl is-active "$SERVICE" 2>/dev/null || true)" != active ]; then rollback; exit 31; fi
echo "✅ GOLD CORE RESTORED: $ROOT"
echo '✅ control-agent/loudness/visual files untouched'
