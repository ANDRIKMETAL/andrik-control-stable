#!/usr/bin/env bash
set -Eeuo pipefail
MASTER='/var/cache/andrik-radio-r622/visuals/stream-morning-master-r703.mp4'
URL='http://127.0.0.1:8080/control/visual-now?slot=morning'
echo '=========================================================='
echo ' ANDRIK R1138 · VIDEO FEEDER RECOVERY'
echo ' CURRENT VISUAL SLOT · NO RADIO RESTART'
echo '=========================================================='
[ -s "$MASTER" ] || { echo "❌ current visual missing: $MASTER"; exit 20; }
W="$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 "$MASTER" | head -1)"
H="$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$MASTER" | head -1)"
FPS="$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of csv=p=0 "$MASTER" | head -1)"
[ "$W" = 1920 ] && [ "$H" = 1080 ] || { echo "❌ visual geometry ${W}x${H}"; exit 21; }
echo "✅ visual: ${W}x${H} fps=${FPS}"
RESP="$(curl -fsS --max-time 15 "$URL")" || { echo '❌ local visual-now failed'; exit 22; }
printf '%s\n' "$RESP"
printf '%s' "$RESP" | grep -Eq '"ok"[[:space:]]*:[[:space:]]*true|"period"|"slot"' || { echo '❌ control response did not confirm visual switch'; exit 23; }
echo '✅ video feeder requested from current morning master'
echo '✅ radio service NOT restarted'
