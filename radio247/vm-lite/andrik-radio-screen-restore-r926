#!/usr/bin/env bash
set -Eeuo pipefail

MASTER="/opt/andrik-radio/recovery/r906-fullscreen-master.mp4"
DST="/var/cache/andrik-radio-r622/visuals/stream-morning-master-r703.mp4"

echo "======================================================"
echo " ANDRIK R990R · ВОССТАНОВИТЬ ЭКРАН"
echo " PERMANENT R906 FULLSCREEN MASTER"
echo "======================================================"

[ -s "$MASTER" ] || {
  echo "❌ Permanent R906 fullscreen master missing:"
  echo "$MASTER"
  exit 20
}

systemctl stop andrik-radio.service
sleep 3

pkill -9 -f 'ffmpeg.*stream-morning-master-r703.mp4' 2>/dev/null || true
sleep 2

install -m 0644 "$MASTER" "$DST"

systemctl start andrik-radio.service
sleep 15

STATE="$(systemctl is-active andrik-radio.service || true)"
echo "service=$STATE"
[ "$STATE" = active ] || exit 21

echo "=== ACTIVE FEEDER ==="
pgrep -af 'ffmpeg.*stream-morning-master-r703.mp4' | head -2 || true

echo "======================================================"
echo "✅ R906 FULLSCREEN VISUAL RESTORED"
echo "======================================================"
