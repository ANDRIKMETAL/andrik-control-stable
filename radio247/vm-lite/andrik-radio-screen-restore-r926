#!/usr/bin/env bash
set -Eeuo pipefail

SERVER="/opt/andrik-radio/radio247/server.mjs"
BACKUPS="/opt/andrik-radio/backups"
STATUS_URL="http://127.0.0.1:8080/status"
POINTER="/etc/andrik-radio-screen-gold-path"
STAMP="$(date +%Y%m%d-%H%M%S)"
SAVE="$BACKUPS/BEFORE-R937-SCREEN-RESTORE-$STAMP-server.mjs"

printf '%s\n' '======================================================'
printf '%s\n' ' ANDRIK R937 · ВОССТАНОВИТЬ ЭКРАН'
printf '%s\n' ' PINNED R936F FULLSCREEN GOLD'
printf '%s\n' ' R935/R936F PRESERVED · R930 UNTOUCHED'
printf '%s\n' '======================================================'

[ -s "$SERVER" ] || { echo '❌ live server.mjs missing'; exit 20; }
[ -s "$POINTER" ] || { echo "❌ GOLD pointer missing: $POINTER"; exit 21; }

SOURCE="$(head -n1 "$POINTER" | tr -d '\r\n')"
[ -n "$SOURCE" ] && [ -s "$SOURCE" ] || { echo "❌ pinned GOLD missing: $SOURCE"; exit 22; }
[ -s "${SOURCE}.sha256" ] || { echo "❌ pinned GOLD SHA file missing: ${SOURCE}.sha256"; exit 23; }

EXPECTED_SHA="$(awk '{print $1}' "${SOURCE}.sha256")"
SOURCE_SHA="$(sha256sum "$SOURCE" | awk '{print $1}')"
[ "$SOURCE_SHA" = "$EXPECTED_SHA" ] || { echo "❌ pinned GOLD SHA mismatch"; exit 24; }

node --check "$SOURCE" >/dev/null

# Hard guard: this button must never fall back to the old pre-R936F server.
grep -Eq 'holdR917B[[:space:]]*=[[:space:]]*0\.05' "$SOURCE" || { echo '❌ GOLD is not R935: hold guard'; exit 25; }
grep -Eq 'const[[:space:]]+TRACK_AUDIO_FADE_IN_R726[[:space:]]*=[[:space:]]*0\.18' "$SOURCE" || { echo '❌ GOLD is not R936F: audio fade-in guard'; exit 26; }
grep -Eq 'const[[:space:]]+TRACK_AUDIO_FADE_OUT_R726[[:space:]]*=[[:space:]]*0\.45' "$SOURCE" || { echo '❌ GOLD is not R936F: audio fade-out guard'; exit 27; }
grep -Eq 'const[[:space:]]+MP3_BOUNDARY_FADE_OUT_SECONDS_R814[[:space:]]*=[[:space:]]*0\.35' "$SOURCE" || { echo '❌ GOLD is not R936F: video fade-out guard'; exit 28; }
grep -Eq 'const[[:space:]]+MP3_BOUNDARY_BLACK_HOLD_SECONDS_R814[[:space:]]*=[[:space:]]*0\.02' "$SOURCE" || { echo '❌ GOLD is not R936F: black-hold guard'; exit 29; }
grep -Eq 'const[[:space:]]+MP3_BOUNDARY_FADE_IN_SECONDS_R814[[:space:]]*=[[:space:]]*0\.30' "$SOURCE" || { echo '❌ GOLD is not R936F: video fade-in guard'; exit 30; }

echo "GOLD=$SOURCE"
echo "GOLD_SHA=$SOURCE_SHA"
echo "LIVE_BEFORE_SHA=$(sha256sum "$SERVER" | awk '{print $1}')"
echo "R930_STATE=$(systemctl is-active andrik-mp4-audio-delay-r930.service 2>/dev/null || true)"

mkdir -p "$BACKUPS"
cp -a "$SERVER" "$SAVE"
echo "✅ current server backup=$SAVE"

cp -af "$SOURCE" "$SERVER"
if ! node --check "$SERVER" >/dev/null; then
  cp -af "$SAVE" "$SERVER"
  echo '❌ node check failed — previous server restored'
  exit 31
fi

COPIED_SHA="$(sha256sum "$SERVER" | awk '{print $1}')"
[ "$COPIED_SHA" = "$SOURCE_SHA" ] || {
  cp -af "$SAVE" "$SERVER"
  echo '❌ copy SHA mismatch — previous server restored'
  exit 32
}

echo '✅ pinned R936F FULLSCREEN server restored'
echo '✅ R935/R936F stay inside restored server'
echo '✅ R930 service/tool untouched'
echo '✅ R2/cache/visual/env untouched'

if ! systemctl restart andrik-radio.service; then
  cp -af "$SAVE" "$SERVER"
  systemctl restart andrik-radio.service || true
  echo '❌ radio restart failed — previous server restored'
  exit 33
fi

READY=0
for I in $(seq 1 60); do
  sleep 2
  if curl -fsS --max-time 3 "$STATUS_URL" >/tmp/r937-screen-status.json 2>/dev/null; then
    if python3 - <<'PY'
import json,sys
try:
    d=json.load(open('/tmp/r937-screen-status.json'))
except Exception:
    sys.exit(1)
ok=all(d.get(k) is True for k in ('publisherRunning','producerRunning','videoFeederRunning','transportHealthy'))
sys.exit(0 if ok else 1)
PY
    then READY=1; break; fi
  fi
done

if [ "$READY" -ne 1 ]; then
  echo '❌ health failed — returning previous server'
  cp -af "$SAVE" "$SERVER"
  node --check "$SERVER" >/dev/null || true
  systemctl restart andrik-radio.service || true
  exit 34
fi

# Re-assert the existing full-fit control only after the proven server is healthy.
curl -fsS -X POST --max-time 8 http://127.0.0.1:8080/control/full-fit >/tmp/r937-full-fit.json 2>/dev/null || true
sleep 3

echo
echo '=== HEALTH ==='
curl -fsS --max-time 5 "$STATUS_URL" | python3 -c '
import sys,json
d=json.load(sys.stdin)
print("publisher :",d.get("publisherRunning"))
print("producer  :",d.get("producerRunning"))
print("video     :",d.get("videoFeederRunning"))
print("transport :",d.get("transportHealthy"))
print("clip      :",d.get("clipActive"))
print("current   :",((d.get("current") or {}).get("title","")))
print("visual    :",d.get("visualPath"))
print("error     :",d.get("lastError",""))
'

echo
echo '======================================================'
echo '🏆 R936F FULLSCREEN GOLD RESTORED'
echo '✅ FAST MP3 BOUNDARY PRESERVED'
echo '✅ R930 EXTERNAL AUDIO TOOL/SERVICE UNTOUCHED'
echo "✅ SERVER SHA=$COPIED_SHA"
echo "↩ UNDO FILE=$SAVE"
echo '======================================================'
