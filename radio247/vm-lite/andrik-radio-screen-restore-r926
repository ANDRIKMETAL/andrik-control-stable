#!/usr/bin/env bash
set -Eeuo pipefail

G="/opt/andrik-radio/backups/GOLD-R906-R905-FULLSCREEN-CLIPS-SHUFFLE-20260904-174845"
V="/var/cache/andrik-radio-r622/visuals"
CUR="$V/stream-morning-master-r703.mp4"

SRC="$(find "$G" -type f -name 'stream-morning-master-r703.mp4' | head -1)"

if [ -z "$SRC" ]; then
  echo "❌ FULLSCREEN R906 source not found"
  exit 1
fi

echo "=== STOP ==="
systemctl stop andrik-radio.service
sleep 3

echo "=== KILL OLD VISUAL FEEDER ==="
pkill -9 -f 'ffmpeg.*stream-morning-master-r703.mp4' 2>/dev/null || true
sleep 2

echo "=== RESTORE TRUE FULLSCREEN VISUAL ==="
install -m 0644 "$SRC" "$CUR"

echo "=== START ==="
systemctl start andrik-radio.service
sleep 15

echo "=== STATUS ==="
systemctl is-active andrik-radio.service

echo "=== ACTIVE FEEDER ==="
pgrep -af 'ffmpeg.*stream-morning-master-r703.mp4' | head -2 || true

echo "✅ FULLSCREEN VISUAL RESTORED"
