#!/usr/bin/env bash
set -Eeuo pipefail
CACHE="/var/cache/andrik-radio-r622"
echo '=== R867 SAFE STATION CACHE CLEAN ==='
[[ -d "$CACHE" ]] || { echo 'Cache directory missing; nothing to clean'; exit 0; }
COUNT=0
while IFS= read -r -d '' F; do
  echo "delete: $F"
  rm -f -- "$F"
  COUNT=$((COUNT+1))
done < <(find "$CACHE" -type f \
  \( -name 'radio-bumper-*.r787-ready.mp4*' \
     -o -name 'radio-special-*.r787-ready.mp4*' \
     -o -name '*.station-r861-real-eof-shortest-av' \
     -o -name '*.station-r864-real-end-only' \
     -o -name '*.station-r865-video-real-eof' \
     -o -name '*.station-r866b-video-eof-only' \) -print0 2>/dev/null)
echo "SAFE CACHE CLEAN ✅ files=$COUNT"
echo 'MP3 cache: untouched'
echo 'visual masters: untouched'
echo 'radio service: NOT restarted'
